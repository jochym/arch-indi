# Modded for nightly HEAD builds
pkgname=indi-3rdparty-drivers
pkgver=r4821.3a5b7c2  # Nadpisywane dynamicznie przez pkgver()
pkgrel=1
pkgdesc="Indi 3rd party drivers - nightly HEAD build"
arch=(aarch64)
url="https://github.com/jochym/indi-3rdparty"
license=(LGPLv2)

# Wspólne zależności
depends=(dfu-util
         fxload
         gpsd
         indi-3rdparty-libs-git
         libdc1394
         limesuite
         urjtag
         zeromq)
makedepends=(cmake git)
options=(!lto)
install=drivers.install

provides=(indi-3rdparty-drivers)
conflicts=(indi-3rdparty-drivers)

# Zależności specyficzne dla architektury aarch64 (Raspberry Pi itp.)
if [ "$CARCH" = "aarch64" ]; then
  depends+=(pigpio)
  makedepends+=(libgpiod)
fi

# Klonowanie repozytorium git do katalogu '3rdparty'
source=('3rdparty::git+https://github.com/jochym/indi-3rdparty.git')
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/3rdparty"
  git describe --long --tags 2>/dev/null | sed 's/\([^-]*-\)*g/r/; s/-/./g; s/^v//' || \
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  rm -rf "${srcdir}/build"
  mkdir -p "${srcdir}/build"
}

build() {
  cd "${srcdir}/build"
  cmake -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DSKIP_SETCAP=yes \
        "${srcdir}/3rdparty"
  make
}

package() {
  cd "${srcdir}/build"
  make DESTDIR="$pkgdir" install
}
